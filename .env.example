# =============================================================================
# TORUN COACH — Environment Variables (prod-ready)
# Kopiera denna fil till .env.local och fyll i värdena.
# .env.local läses automatiskt av Next.js i utveckling.
# I produktion (Vercel): lägg in samma variabler under Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# RESEND — för transaktionsmejl (subscribe + kontaktformulär + Stripe-bekräftelser)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_YOUR_RESEND_API_KEY_HERE
# Format: "Namn <mejl@verifierad-domän.se>" — domänen måste vara verifierad hos Resend
# För launch: verifiera torun.se i Resend Dashboard → Domains, lägg till DNS records (TXT, MX etc).
# Rekommenderat FROM efter verify: "TORUN. <hej@torun.se>" eller "Torun Wallin <hej@torun.se>"
RESEND_FROM=TORUN. <onboarding@resend.dev>
NOTIFY_EMAIL=itorun@me.com

# URL till startguide-PDF (gratis 7-dagars) som skickas vid newsletter-anmälan
GUIDE_URL=https://torun.se/torun-startguide.pdf
# URL till Kickstart-handboken som skickas efter köp av Kickstart
KICKSTART_PDF_URL=https://torun.se/kickstart-handbook.pdf

# -----------------------------------------------------------------------------
# STRIPE — för betalningar (endast Kickstart är direkt-checkout just nu; Stark/1:1 via kontakt)
# Hämta från https://dashboard.stripe.com/test/apikeys (test mode) eller
# https://dashboard.stripe.com/apikeys (live mode)
# -----------------------------------------------------------------------------
# Secret key — börjar med sk_test_ (test) eller sk_live_ (live)
STRIPE_SECRET_KEY=sk_live_YOUR_LIVE_KEY_HERE   # eller sk_test_YOUR_TEST_KEY för dev

# Price ID för Kickstart-produkten (engångsbetalning) — börjar med price_
# Skapas i Stripe Dashboard → Products → New product (t.ex. 795 kr eller 636 kr för launch)
# OBS: om du kör launch-erbjudande på Kickstart, sätt priset i Stripe till 636 kr och aktivera i lib/offer.ts
STRIPE_PRICE_KICKSTART=price_YOUR_PRICE_ID_HERE

# Webhook signing secret — börjar med whsec_
# Lokal utveckling: kör `stripe listen --forward-to localhost:3000/api/webhook/stripe`
# Produktion (live): 
#   1. Dashboard → Developers → Webhooks → Add endpoint
#   2. Endpoint URL: https://torun.se/api/webhook/stripe
#   3. Välj event: checkout.session.completed
#   4. Kopiera "Signing secret" (whsec_live_...)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# -----------------------------------------------------------------------------
# SITE — den publika URL:en till sajten (används för Stripe success/cancel + länkar)
# -----------------------------------------------------------------------------
# Lokalt:  http://localhost:3000
# Live:    https://torun.se   ← Sätt detta i Vercel för prod (och i .env.local för test av prod-URLs)
NEXT_PUBLIC_SITE_URL=https://torun.se
